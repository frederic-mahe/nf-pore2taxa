/*
 * Institutional cluster profile TEMPLATE.
 *
 * The five shipped profiles (abims, genotoul, ifb_core, meso, saga) are
 * sites we actually run on. For a sixth: copy this file to
 * conf/clusters/<name>.config, fill in the values, then register it in
 * nextflow.config:
 *
 *     profiles {
 *         <name> {
 *             includeConfig 'conf/slurm.config'            // executor plumbing
 *             includeConfig 'conf/clusters/<name>.config'  // this file
 *         }
 *     }
 *
 * A cluster profile *implies* slurm, so a user runs
 * `-profile <name>,apptainer` and never lists `slurm`.
 *
 * Override only what is genuinely site-specific. The per-process
 * cpus/memory tiers live in nextflow.config and apply everywhere; the
 * walltimes and submission plumbing live in conf/slurm.config. A cluster
 * file just retargets the executor at the site: partitions, accounts, the
 * node-size ceiling, bind mounts.
 *
 * Do not copy nf-core-isms here (igenomes_base, config_profile_*,
 * schema_ignore_params): this pipeline does not use them.
 */

params {
    // resourceLimits ceiling — set to the LARGEST node the site offers, so
    // the per-retry escalation in conf/slurm.config is clamped to what
    // actually exists instead of looping to failure. Unquoted Nextflow
    // MemoryUnit / Duration values, as in the shipped profiles.
    max_cpus   = 16
    max_memory = 128.GB
    max_time   = 240.h

    // Batch ready tasks into one `sbatch --array` submission instead of one
    // sbatch each. Worth setting: this pipeline runs one task per barcode,
    // up to 96 per run. null = one job per task.
    slurm_array_size = 50

    // Set true if the site rejects submissions without an account, so
    // main.nf refuses at startup instead of every sbatch bouncing.
    // require_slurm_account = true
}

process {
    // Rebuild the ceiling from the params just set above (config is
    // evaluated in file order, so this picks up this file's values rather
    // than conf/slurm.config's).
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Partition selection. conf/slurm.config leaves this at
    // params.slurm_queue (null). Most sites route by task size — pick the
    // partition from task.memory and/or task.time, e.g.:
    // queue = { task.memory <= 250.GB ? (task.time <= 24.h ? 'fast' : 'long') : 'bigmem' }

    array = params.slurm_array_size

    // Account / extra sbatch flags. conf/slurm.config already builds
    // `--account=${params.slurm_account}` (plus slurm_clusterOptions), so
    // override this ONLY when the site derives the account from the job's
    // size or duration (see conf/clusters/meso.config). Otherwise leave it
    // out and pass --slurm_account on the CLI or in a -c site.config.

    // If the engine is provided as an environment module, load it here —
    // see conf/clusters/genotoul.config for the containerEngine-aware form.
    // beforeScript = 'module load ...'
}

// Container engine plumbing. The engine itself (enabled + Wave) is turned
// on by the profile the user adds, e.g. `-profile <name>,apptainer`; here
// we only add the site's bind mounts and, optionally, a shared image cache
// so the built image is reused across compute nodes.
//
// IMPORTANT: DOTTED assignment (`apptainer.runOptions = ...`), NEVER an
// `apptainer { }` block. Reached through this file's includeConfig on
// Nextflow 25.10.x, a block-form engine scope silently drops the engine
// profile's `enabled = true` — the container is then disabled and the run
// falls back to a local conda env, with no error. Dotted assignment is
// immune. The CI Nextflow version matrix exists to catch this.
//
// apptainer.autoMounts = true
// apptainer.runOptions = '-B /shared'
// apptainer.cacheDir   = '/shared/.../apptainer_cache'
// singularity.autoMounts = true
// singularity.runOptions = '-B /shared'
// singularity.cacheDir   = '/shared/.../singularity_cache'
