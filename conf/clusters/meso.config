/*
 * Institutional cluster profile: MESO@LR / CIRAD dedicated partitions
 *
 * Imported from nf-metabarcoding (same author, same users, same sites),
 * whose conf/clusters/ files carry only site facts and no
 * pipeline-specific content. Values are that site's, unchanged; only the
 * comments are adapted.
 *
 * Implies slurm (it includes conf/slurm.config), so run it as
 * `-profile meso` or `-profile meso,apptainer` — never list `slurm`.
 *
 * BASECALL is not supported here: basecalling is local-only (dorado is a
 * GPU binary outside the conda environment, and the queue closure below
 * routes on memory/time, so it would land on a CPU node). Basecall on the
 * workstation, then run with `--skip_basecall`. main.nf refuses at startup
 * if you ask for basecalling under a scheduler.
 *
 * IMPORTANT: engine settings use DOTTED assignment
 * (`apptainer.runOptions = ...`), never a `apptainer { }` block. Reached
 * through includeConfig on Nextflow 25.10.x, a block-form engine scope
 * silently drops the engine profile's `enabled = true`, the container is
 * disabled, and the run falls back to a local conda env. Dotted assignment
 * is immune. The CI Nextflow matrix exists to catch exactly this.
 */

params {
    // resourceLimits ceiling: the LARGEST node the site offers, so the
    // per-retry escalation is clamped to something that exists instead of
    // looping to failure.
    max_cpus   = 186
    max_memory = 3800.GB
    max_time   = 168.h

    slurm_array_size = 50
}

process {
    // Rebuilt from the params just set above (config is evaluated in file
    // order, so this picks up this file's values).
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    queue = { task.memory > 1400.GB ? 'bigmem-cirad-dedicated' : 'cpu-dedicated' }
    array = params.slurm_array_size

    // This site derives the account from the job's size and duration, so
    // it overrides the closure in conf/slurm.config rather than taking
    // --slurm_account. Any --slurm_clusterOptions are still appended.
    clusterOptions = {
        def account
        if (task.memory > 1400.GB) {
            account = 'dedicated-bigmem@cirad-long'
        } else if (task.time <= 1.h) {
            account = 'dedicated-cpu@cirad-default'
        } else if (task.time <= 48.h) {
            account = 'dedicated-cpu@cirad-normal'
        } else {
            account = 'dedicated-cpu@cirad-long'
        }
        [ "--account=${account}", params.slurm_clusterOptions ?: null ].findAll().join(' ') ?: null
    }
}

singularity.autoMounts = true
singularity.runOptions = '-B /scratch -B /storage'
apptainer.autoMounts   = true
apptainer.runOptions   = '-B /scratch -B /storage'