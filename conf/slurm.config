/*
 * Slurm executor profile.
 *
 * Included by the `slurm` profile and by every institutional cluster
 * profile in conf/clusters/, which then layer their site's values on top.
 * A cluster profile *implies* slurm, so a user runs e.g.
 * `-profile abims,apptainer` and never lists `slurm` themselves.
 *
 * DIVERGENCE FROM nf-metabarcoding, deliberately: that pipeline's
 * conf/slurm.config restates every process's cpus/memory. Here the
 * per-process cpus/memory tiers stay in nextflow.config, so they apply
 * identically on a workstation and on a cluster and cannot drift apart.
 * This file adds only what a *scheduler* needs and the local executor has
 * no use for: submission plumbing, a queue, an account, job arrays, and
 * walltime.
 *
 * BASECALL is absent on purpose — see the note at the bottom.
 */

// --- submission -------------------------------------------------------------

params.slurm_queue   = null   // sbatch -p / --partition
params.slurm_account = null   // sbatch -A / --account

// Extra sbatch options appended verbatim to every submit line (QoS,
// constraints, reservations) — the one knob a site needs for flags it
// cannot express through slurm_queue/slurm_account. Set it in a
// `-c site.config`; see conf/site.config.example.
params.slurm_clusterOptions = null

// Max concurrent sbatch jobs the driver keeps in flight.
params.slurm_queue_size = 100

// Opt-in slurm job arrays. When set to N > 1, Nextflow batches up to N
// ready tasks of a process into a single `sbatch --array` submission
// instead of one sbatch per task. This pipeline's shape — one SINTAX task
// per barcode, up to 96 of them — is exactly what arrays are for, and it
// is what HPC admins ask for at scale. null (default) = one job per task.
params.slurm_array_size = null

// Require an account, for sites that reject a submission without one. A
// cluster profile sets this true (see conf/clusters/abims.config) and
// main.nf then refuses at startup rather than letting every sbatch bounce.
params.require_slurm_account = false


// --- resource ceiling -------------------------------------------------------
//
// Set EXPLICITLY here, never auto-detected. The defaults in
// nextflow.config come from the host Nextflow runs on, which under slurm is
// the SUBMIT node: its size says nothing about the compute nodes, so
// inheriting it would silently shrink every submitted job to the login
// node's shape. (Bare `-profile slurm` did exactly that until CFG-04c
// caught it.)
//
// These are deliberately conservative placeholders, not any real site's
// numbers. Override them with the LARGEST node your partition offers —
// either by using one of the shipped site profiles, which do it for you, or
// in a `-c site.config` (see conf/site.config.example) — so the per-retry
// escalation is clamped to something that exists instead of looping to
// failure. An explicit --max_cpus / --max_memory / --max_time still wins.
params.max_cpus   = 16
params.max_memory = 128.GB
params.max_time   = 240.h


process {
    executor       = 'slurm'
    queue          = params.slurm_queue

    // null -> directive omitted, one job per task. Evaluated here so a CLI
    // --slurm_array_size takes effect; a cluster profile that wants a
    // default re-binds this after including this file.
    array          = params.slurm_array_size

    // --account plus any site-supplied extras. Either, both or neither may
    // be set; the closure yields null when neither is, so the directive is
    // omitted entirely rather than emitted empty.
    clusterOptions = {
        [ params.slurm_account ? "--account=${params.slurm_account}" : null,
          params.slurm_clusterOptions ?: null
        ].findAll().join(' ') ?: null
    }

    // Rebuild the ceiling from the params set above, which are explicit
    // rather than auto-detected. A cluster profile overrides them again with
    // its own largest node and rebuilds this once more (config is evaluated
    // in file order). `time` is included here but not in nextflow.config's
    // ceiling: only a scheduler enforces walltime.
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // --- walltime ----------------------------------------------------------
    //
    // Absent from nextflow.config because the local executor has no
    // walltime enforcer, but mandatory here: without a `time` directive
    // every job inherits the queue's default limit and is killed there,
    // typically mid-run and without explanation. Scaled by task.attempt,
    // and the existing errorStrategy already retries exit 137..140 — the
    // range a scheduler walltime kill lands in — so a job that outgrew its
    // slot gets a longer one on retry.
    time = { 1.h * task.attempt }

    withName: 'SINTAX' {
        // The dominant cost: reference load plus a per-read k-mer search.
        time = { 4.h * task.attempt }
    }
    withName: 'BUILD_TABLE' {
        time = { 2.h * task.attempt }
    }
    withName: 'KRONA' {
        time = { 30.min * task.attempt }
    }
    withName: 'DISCOVER_BARCODES|DUMP_VERSIONS|DUMP_PARAMS' {
        // Filesystem walk / a couple of --version calls / one heredoc.
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 15.min * task.attempt }
    }

    // NO BASECALL tier. Basecalling is local-only: dorado is an ONT GPU
    // binary that is not in the conda environment or any container we
    // build, so it must be installed on the node that runs it, and the
    // queue-routing closures in conf/clusters/ select partitions by memory
    // and time — they would send BASECALL to a CPU node with no GPU on it.
    // main.nf refuses at startup when basecalling is requested under a
    // scheduler, rather than submitting a job that cannot work. Basecall on
    // the GPU workstation, then run the cluster half with
    // `--skip_basecall`. Adding GPU routing here means per-site partition
    // names, --gres syntax and possibly a different account, none of which
    // can be guessed for a site we have not seen.
}


executor {
    queueSize       = params.slurm_queue_size
    submitRateLimit = '50/1min'
    pollInterval    = '30 sec'
}
