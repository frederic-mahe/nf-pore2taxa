/*
 * Which processes get their tools from environment.yml.
 *
 * Included by the `conda` profile (native conda) and by each container
 * engine profile (where Wave reads this same directive to build the
 * image). One file so the list cannot drift between the two paths.
 *
 * Never included at top level: a plain `nextflow run` stays bare-PATH.
 *
 * BASECALL is deliberately absent. dorado is an Oxford Nanopore GPU binary
 * that is not distributed on bioconda, so it cannot be in environment.yml,
 * and giving BASECALL a conda directive would hand it a container (or an
 * env) without the one tool it needs. It stays bare-PATH and requires
 * dorado + pigz installed on the machine that runs it — which is the
 * workstation: basecalling is local-only.
 */

process {
    withName: 'SINTAX'        { conda = "${projectDir}/environment.yml" }
    withName: 'BUILD_TABLE'   { conda = "${projectDir}/environment.yml" }
    withName: 'KRONA'         { conda = "${projectDir}/environment.yml" }
    // The version probe must resolve the tools from the SAME environment
    // the analysis used, or it would report the bare-PATH versions while
    // the run used the packaged ones — worse than reporting nothing.
    withName: 'DUMP_VERSIONS' { conda = "${projectDir}/environment.yml" }
}
