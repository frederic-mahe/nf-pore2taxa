manifest {
    name        = 'nf-pore2taxa'
    version     = '1.11.0'
    description = 'Nanopore metabarcoding (quick) taxonomic assignment workflow'
    author      = 'Frédéric Mahé'
    homePage    = 'https://github.com/frederic-mahe/nf-pore2taxa'
    mainScript  = 'main.nf'
    defaultBranch = 'main'

    // Minimum Nextflow. This is the floor for `process.resourceLimits`
    // (added in 24.04), which the resource ceiling below depends on: on an
    // older Nextflow the directive is ignored, so every request would go
    // through unclamped and the "requirement exceeds available" failure
    // this pipeline is built to avoid would come back — silently, since an
    // unknown directive is not an error. Declaring it here turns that into
    // a clear refusal at startup.
    //
    // CI now resolves the cluster/container profiles on a PINNED 25.10.2
    // as well as the latest stable, which is what makes this floor more
    // than a claim (that matrix also guards the block-form container scope
    // trap — see conf/clusters/_template.config). The full test suite
    // still runs on one version only, so treat the floor as the documented
    // requirement of the feature we depend on rather than a fully
    // exercised one. Do not lower it without checking resourceLimits.
    nextflowVersion = '>=24.04.0'
}

// Delete the work directory when a run completes successfully.
//
// Default false (v1.7.1): a successful run stays resumable across
// separate invocations, a "succeeded but looks wrong" run stays
// inspectable, and — critically — the `symlink`/`rellink` publish modes
// stop producing dangling links into a deleted work dir (every published
// output silently unreadable, while the run reports SUCCESS). Set
// `--cleanup` (or `cleanup = true` in a project config) for throwaway
// runs that should reclaim `work/` automatically; `nextflow clean -f`
// does the same after the fact.
//
// The `"${...}" == 'true'` spelling is the same coercion coerce_bool()
// applies (modules/local/functions.nf, which a config file cannot
// include): a CLI `--cleanup false` arrives as the *string* 'false',
// which is truthy in Groovy. Startup validation rejects any other value.
cleanup = "${params.cleanup}" == 'true'

params {
    // Paths — no defaults, must be supplied via project config or CLI
    pod5_dir          = null
    fastq_dir         = null
    sintax_references = null
    sintax_silva      = null  // deprecated alias for sintax_references
    results_table     = null
    primer_f          = null
    primer_r          = null

    // Workflow behaviour
    skip_basecall     = false

    // --- basecalling (only when skip_basecall = false) -----------------
    //
    // Basecalling is LOCAL-ONLY: dorado is an Oxford Nanopore GPU binary
    // that is not on bioconda, so it is in neither environment.yml nor any
    // container built from it, and a run that requests it under a scheduler
    // is refused at startup. These were hardcoded in
    // bin/basecall_pod5_files.sh until v1.11.0, which meant a lab with a
    // different sequencing kit could not use basecalling at all.
    //
    // Model: the short form is <speed>@v<version> and gets the
    // flowcell/chemistry prefix 'dna_r10.4.1_e8.2_400bps_' prepended; pass a
    // FULL dorado model name to target other chemistry (e.g.
    // 'dna_r9.4.1_e8_hac@v3.3.0').
    basecall_model    = 'sup@v5.2.0'

    // Sequencing/barcoding kit, as dorado's --kit-name (XXX-XXX000).
    basecall_kit      = 'EXP-PBC096'

    // Compute device for dorado: cpu, auto, metal, cuda:0, cuda:all,
    // cuda:0,1. 'cuda:0' was hardcoded, which excluded CPU-only machines
    // and multi-GPU nodes alike.
    basecall_device   = 'cuda:0'

    // Persistent cache for the basecalling model, held OUTSIDE the work
    // directory by a storeDir process, so the ~1 GB download happens once
    // instead of on every run (the script used to fetch it into the task
    // directory, where its own clean_up then deleted it). Point this at any
    // stable, writable location — a shared one if several projects
    // basecall on the same machine.
    basecall_model_dir = "${launchDir}/dorado_models"

    // Seed for vsearch's random generator in the sintax step. 0 (default)
    // lets vsearch pick a pseudo-random seed each run; set a positive
    // integer for reproducible single-threaded runs. Note: results are
    // not exactly replicable under multithreading even with a fixed seed.
    randseed          = 0

    // Cap each barcode at this many reads BEFORE trimming: the barcode's
    // fastq files are pooled into one fastq, then subsampled with vsearch
    // (using `randseed`) so only this many reads are trimmed and assigned.
    // 0 (default) disables subsampling and keeps every read. With
    // discard_untrimmed = true the number of assigned reads may be smaller
    // than this cap (primer-less reads in the subsample are dropped).
    subsample         = 0

    // Render interactive Krona HTML charts from the occurrence tables
    // (one dataset per barcode; krona.html + krona_optimistic.html,
    // published beside results_table). false (default) skips this step.
    // Requires KronaTools (ktImportText); provided by the conda profile.
    krona             = false

    // Print the help message and exit (see helpMessage() in main.nf).
    help              = false

    // Primer-presence filtering. true (default): drop reads in which a
    // primer is not found (strict amplicon filtering). false: keep every
    // read, trimming primers only where they are found.
    discard_untrimmed = true

    // publishDir mode for every published output. 'link' (fast hard
    // link) is correct when workDir and the data/results directories
    // share a filesystem; set 'copy' when they are on different
    // filesystems (hard links cannot cross devices). See the README
    // same-filesystem warning. Validated at workflow startup.
    //
    // 'symlink'/'rellink' are accepted but are only safe with
    // cleanup = false (the default) — startup validation rejects the
    // combination rather than letting it publish dangling links.
    // 'move' is NOT accepted: BASECALL's downstream handoff reads the
    // fastq back out of the task work directory, which moving them away
    // would empty.
    publish_mode      = 'link'

    // Remove the work directory on successful completion. See the
    // `cleanup` assignment above, which consumes this.
    cleanup           = false

    // Resource ceiling. Every per-process request below (including the
    // `* task.attempt` escalation on retry) is clamped to these by
    // `process.resourceLimits`, so a step can never ask for more than the
    // machine has. Without it the local executor refuses outright —
    // "Process requirement exceeds available CPUs -- req: 20; avail: 8" —
    // which is how a lab's first run died on any workstation with fewer
    // than 20 cores, before any biology, with an error that reads like
    // their machine is at fault.
    //
    // The defaults are what the machine actually has, queried through the
    // same helper the local executor uses to produce that error, so the
    // two cannot disagree. Override either explicitly (--max_cpus 8
    // --max_memory '32.GB') to leave headroom for other work.
    //
    // NOTE for schedulers: these values describe the host Nextflow runs
    // ON. That is right for the local executor and WRONG on a submit
    // node, whose core count says nothing about the compute nodes — a
    // 4-core login node would silently shrink every submitted job.
    // conf/slurm.config therefore overrides both with explicit values and
    // never consults the helper, and each site profile overrides them
    // again with its own largest node. CFG-04c / CLU-03b pin that.
    max_cpus          = nextflow.util.SysHelper.getAvailCpus()
    max_memory        = nextflow.util.SysHelper.getAvailMemory()

    // Walltime ceiling. Only meaningful under a scheduler (the local
    // executor has no walltime enforcer), so conf/slurm.config is where the
    // `time` directives live; this default exists so the param is always
    // defined and validated.
    max_time          = 240.h

    // Approximate size of the sintax reference database, in GB. vsearch
    // loads the reference and builds a k-mer index several times its size,
    // so SINTAX scales its memory request off this rather than guessing.
    // null (default) keeps the fixed fallback below — generous for a small
    // ITS/COI database, potentially too little for a full SILVA.
    reference_size_gb = null
}

// Execution reports, on by default: provenance you have to remember to
// enable is provenance you will not have. All four land in
// pipeline_info/ beside the occurrence tables, next to
// software_versions.yml and params.json, so one directory holds
// everything needed to explain a run.
//
// Fixed filenames + overwrite = true, so a re-run or `-resume` refreshes
// them in place. The trade-off, stated plainly: a `-resume` report
// describes the resumed run (mostly cached tasks) and replaces the
// original run's report. Archive pipeline_info/ if you need to keep both.
//
// The path is spelled out in each block rather than shared, because these
// are config values resolved after the params merge (so a CLI
// `--results_table` is honoured) while a computed entry inside the
// `params` block would capture the default and miss the override. A bare
// filename has no parent, hence the `?: '.'`; a null results_table (as
// during `--help` or `nextflow config`) falls back to 'results' so the
// config still resolves instead of throwing.
report {
    enabled   = true
    overwrite = true
    file      = "${params.results_table ? (new File("${params.results_table}").parent ?: '.') : 'results'}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.results_table ? (new File("${params.results_table}").parent ?: '.') : 'results'}/pipeline_info/execution_timeline.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.results_table ? (new File("${params.results_table}").parent ?: '.') : 'results'}/pipeline_info/execution_trace.txt"
    // Requested vs observed resources up front: with the v1.8.0 ceiling
    // clamping requests, this is how a lab sees whether a step was given
    // too little (or far too much) on their machine.
    fields    = 'task_id,hash,name,status,exit,attempt,cpus,memory,realtime,%cpu,peak_rss,peak_vmem'
}
dag {
    enabled   = true
    overwrite = true
    // .html renders with Nextflow's bundled mermaid — no graphviz needed,
    // which matters on a workstation nobody wants to install dot on.
    file      = "${params.results_table ? (new File("${params.results_table}").parent ?: '.') : 'results'}/pipeline_info/pipeline_dag.html"
}

profiles {
    standard {
        process.executor = 'local'
    }
    // Slurm executor. All the submission plumbing, walltimes and the
    // scheduler-appropriate resource ceiling live in conf/slurm.config, so
    // the institutional profiles below can reuse them via includeConfig
    // rather than each restating them.
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // Retained as an alias of `slurm`: it is the name shipped since
    // v1.0.0 and project configs in the wild use it. Same resolution, so
    // nothing breaks; `slurm` is the documented name from v1.10.0 on
    // because the institutional profiles are named after their sites.
    cluster {
        includeConfig 'conf/slurm.config'
    }

    // Institutional cluster profiles: same sites, same users as
    // nf-metabarcoding, from which these are imported. Each implies slurm,
    // so run `-profile <site>` or `-profile <site>,apptainer` — never list
    // `slurm` as well. A sixth site starts from
    // conf/clusters/_template.config.
    abims {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/clusters/abims.config'
    }
    genotoul {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/clusters/genotoul.config'
    }
    ifb_core {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/clusters/ifb_core.config'
    }
    meso {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/clusters/meso.config'
    }
    saga {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/clusters/saga.config'
    }

    // Container engines. Each enables its engine plus Seqera Wave, which
    // builds the image on the fly from the same pinned environment.yml that
    // drives `-profile conda` — no Dockerfile, no registry, and one source
    // of truth for versions. Compose with an executor profile:
    // `-profile abims,apptainer`.
    //
    // This matters most on a cluster: conda on a shared filesystem is slow,
    // a shared NXF_CONDA_CACHEDIR races between concurrent runs, and plenty
    // of sites disallow conda outright.
    //
    // The Wave-from-conda combination is `wave.enabled` + an engine + a
    // process `conda` directive (conf/tool_env.config). Do NOT also set
    // `conda.enabled = true` here: that is the master switch for Nextflow's
    // *native* conda integration, independent of Wave, and it would make
    // Nextflow additionally run a local `conda env create` on the launch
    // node — on an HPC login node that blocks on a slow solve and can fail,
    // stalling the run before a single task is submitted. Pick `-profile
    // conda` only when you want native conda and no container.
    //
    // BASECALL gets no conda directive (see conf/tool_env.config), so it is
    // never containerised and still needs dorado on PATH — on the
    // workstation, since basecalling is local-only.
    //
    // Wave needs outbound network from wherever tasks run. For air-gapped
    // nodes see the pre-built image section of conf/site.config.example.
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        wave.enabled         = true
        includeConfig 'conf/tool_env.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled           = true
        includeConfig 'conf/tool_env.config'
    }
    docker {
        docker.enabled = true
        wave.enabled   = true
        includeConfig 'conf/tool_env.config'
    }
    podman {
        podman.enabled = true
        wave.enabled   = true
        includeConfig 'conf/tool_env.config'
    }
    // Resolve cutadapt/vsearch/python from the pinned environment.yml
    // instead of the bare PATH. Compose with any executor profile, e.g.
    // `-profile standard,conda`. Nextflow builds the env once and caches
    // it under $NXF_CONDA_CACHEDIR.
    //
    // dorado is not on bioconda (see environment.yml), so the conda
    // directive is scoped to the tool steps that CAN be packaged; the
    // BASECALL process stays bare-PATH and still needs dorado + pigz
    // installed where it runs.
    // Native conda: no container. The per-process list lives in
    // conf/tool_env.config, shared with the engine profiles so the two
    // paths cannot disagree about which processes are packaged.
    conda {
        conda.enabled = true
        includeConfig 'conf/tool_env.config'
    }
}

// Default resource hints — override per-process in modules if needed.
//
// Resilience: retry only failures that more resources can fix. Exit
// codes 137..140 are the OOM / SIGKILL / SIGTERM range (e.g. an OOM
// killer or a scheduler walltime kill); those get up to `maxRetries`
// attempts with escalating memory. Deterministic failures (e.g. a
// validation error, exit 1) terminate immediately — retrying them only
// wastes time. Memory escalates with `task.attempt`: this is a genuine
// win under a scheduler (a bigger node on retry); on the local executor
// RAM is fixed, so it is mainly forward-compatibility for the `cluster`
// profile. `time` stays commented out until the cluster profile is
// fleshed out — there is no walltime enforcer under the local executor.
//
// The requests below are what each step *wants*. `resourceLimits` clamps
// every one of them — and every retry's escalated value — to
// params.max_cpus / params.max_memory, so they can be written for a
// well-provisioned machine without failing to schedule on a small one.
// A request above the ceiling is silently reduced, not refused: the
// startup notice in main.nf reports the effective ceiling so a run that
// used fewer threads than requested is explicable rather than mysterious.
process {
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory ]

    cpus   = 4
    memory = { 16.GB * task.attempt }
    // time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'BASECALL' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        // time   = { 12.h * task.attempt }
    }
    withName: 'SINTAX' {
        cpus   = 20
        // vsearch loads the whole reference and builds a k-mer index that
        // inflates it several-fold, so the request tracks the *reference*
        // size, not the read count. With --reference_size_gb unset this is
        // the historical fixed 16 GB, which is generous for a small
        // ITS/COI database and can be too little for a full SILVA.
        memory = { params.reference_size_gb
                       ? "${(params.reference_size_gb.toDouble() * 4 * task.attempt) as int} GB"
                       : 16.GB * task.attempt }
    }
    withName: 'BUILD_TABLE' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }
}
