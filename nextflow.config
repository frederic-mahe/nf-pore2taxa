manifest {
    name        = 'nf-pore2taxa'
    version     = '1.8.0'
    description = 'Nanopore metabarcoding (quick) taxonomic assignment workflow'
    author      = 'Frédéric Mahé'
    homePage    = 'https://github.com/frederic-mahe/nf-pore2taxa'
    mainScript  = 'main.nf'
    defaultBranch = 'main'

    // Minimum Nextflow. This is the floor for `process.resourceLimits`
    // (added in 24.04), which the resource ceiling below depends on: on an
    // older Nextflow the directive is ignored, so every request would go
    // through unclamped and the "requirement exceeds available" failure
    // this pipeline is built to avoid would come back — silently, since an
    // unknown directive is not an error. Declaring it here turns that into
    // a clear refusal at startup.
    //
    // Honest caveat: CI exercises one Nextflow version (the latest
    // stable), so this floor is the documented requirement of the feature
    // we use, not a version we have run the suite against. A pinned +
    // latest CI matrix is what would make it trustworthy — planned with
    // the cluster work, where it also guards the block-form container
    // scope trap. Do not lower it without checking resourceLimits.
    nextflowVersion = '>=24.04.0'
}

// Delete the work directory when a run completes successfully.
//
// Default false (v1.7.1): a successful run stays resumable across
// separate invocations, a "succeeded but looks wrong" run stays
// inspectable, and — critically — the `symlink`/`rellink` publish modes
// stop producing dangling links into a deleted work dir (every published
// output silently unreadable, while the run reports SUCCESS). Set
// `--cleanup` (or `cleanup = true` in a project config) for throwaway
// runs that should reclaim `work/` automatically; `nextflow clean -f`
// does the same after the fact.
//
// The `"${...}" == 'true'` spelling is the same coercion coerce_bool()
// applies (modules/local/functions.nf, which a config file cannot
// include): a CLI `--cleanup false` arrives as the *string* 'false',
// which is truthy in Groovy. Startup validation rejects any other value.
cleanup = "${params.cleanup}" == 'true'

params {
    // Paths — no defaults, must be supplied via project config or CLI
    pod5_dir          = null
    fastq_dir         = null
    sintax_references = null
    sintax_silva      = null  // deprecated alias for sintax_references
    results_table     = null
    primer_f          = null
    primer_r          = null

    // Workflow behaviour
    skip_basecall     = false

    // Seed for vsearch's random generator in the sintax step. 0 (default)
    // lets vsearch pick a pseudo-random seed each run; set a positive
    // integer for reproducible single-threaded runs. Note: results are
    // not exactly replicable under multithreading even with a fixed seed.
    randseed          = 0

    // Cap each barcode at this many reads BEFORE trimming: the barcode's
    // fastq files are pooled into one fastq, then subsampled with vsearch
    // (using `randseed`) so only this many reads are trimmed and assigned.
    // 0 (default) disables subsampling and keeps every read. With
    // discard_untrimmed = true the number of assigned reads may be smaller
    // than this cap (primer-less reads in the subsample are dropped).
    subsample         = 0

    // Render interactive Krona HTML charts from the occurrence tables
    // (one dataset per barcode; krona.html + krona_optimistic.html,
    // published beside results_table). false (default) skips this step.
    // Requires KronaTools (ktImportText); provided by the conda profile.
    krona             = false

    // Print the help message and exit (see helpMessage() in main.nf).
    help              = false

    // Primer-presence filtering. true (default): drop reads in which a
    // primer is not found (strict amplicon filtering). false: keep every
    // read, trimming primers only where they are found.
    discard_untrimmed = true

    // publishDir mode for every published output. 'link' (fast hard
    // link) is correct when workDir and the data/results directories
    // share a filesystem; set 'copy' when they are on different
    // filesystems (hard links cannot cross devices). See the README
    // same-filesystem warning. Validated at workflow startup.
    //
    // 'symlink'/'rellink' are accepted but are only safe with
    // cleanup = false (the default) — startup validation rejects the
    // combination rather than letting it publish dangling links.
    // 'move' is NOT accepted: BASECALL's downstream handoff reads the
    // fastq back out of the task work directory, which moving them away
    // would empty.
    publish_mode      = 'link'

    // Remove the work directory on successful completion. See the
    // `cleanup` assignment above, which consumes this.
    cleanup           = false

    // Resource ceiling. Every per-process request below (including the
    // `* task.attempt` escalation on retry) is clamped to these by
    // `process.resourceLimits`, so a step can never ask for more than the
    // machine has. Without it the local executor refuses outright —
    // "Process requirement exceeds available CPUs -- req: 20; avail: 8" —
    // which is how a lab's first run died on any workstation with fewer
    // than 20 cores, before any biology, with an error that reads like
    // their machine is at fault.
    //
    // The defaults are what the machine actually has, queried through the
    // same helper the local executor uses to produce that error, so the
    // two cannot disagree. Override either explicitly (--max_cpus 8
    // --max_memory '32.GB') to leave headroom for other work.
    //
    // NOTE for schedulers: these values describe the host Nextflow runs
    // ON. That is right for the local executor and WRONG on a submit
    // node, whose core count says nothing about the compute nodes — a
    // 4-core login node would silently shrink every submitted job. The
    // `cluster` profile therefore sets both explicitly and never consults
    // the helper; see the profile below.
    max_cpus          = nextflow.util.SysHelper.getAvailCpus()
    max_memory        = nextflow.util.SysHelper.getAvailMemory()
}

profiles {
    standard {
        process.executor = 'local'
    }
    cluster {
        process.executor  = 'slurm'
        process.queue     = 'normal'

        // Ceiling for a scheduler: set EXPLICITLY, never auto-detected.
        // params.max_cpus/max_memory at the top of this file describe the
        // host Nextflow runs on, which under slurm is the submit node —
        // its size is unrelated to the compute nodes, so detecting it
        // would silently shrink every submitted job.
        //
        // These are deliberately conservative placeholders, not any real
        // site's numbers: a site overrides them in a `-c site.config`
        // (or, once the institutional profiles are imported, in its own
        // cluster profile) with the LARGEST node it offers, so the retry
        // escalation is clamped to something that exists instead of
        // looping to failure. Same shape as nf-metabarcoding's
        // conf/slurm.config.
        params.max_cpus   = 16
        params.max_memory = 128.GB

        // Rebuild the ceiling from the values just set: config is
        // evaluated in file order, so this picks up the two lines above
        // rather than the auto-detected defaults.
        process.resourceLimits = [ cpus: 16, memory: 128.GB ]
    }
    // Resolve cutadapt/vsearch/python from the pinned environment.yml
    // instead of the bare PATH. Compose with any executor profile, e.g.
    // `-profile standard,conda`. Nextflow builds the env once and caches
    // it under $NXF_CONDA_CACHEDIR.
    //
    // dorado is not on bioconda (see environment.yml), so the conda
    // directive is scoped to the tool steps that CAN be packaged; the
    // BASECALL process stays bare-PATH and still needs dorado + pigz
    // installed where it runs.
    conda {
        conda.enabled = true
        process {
            withName: 'SINTAX'      { conda = "${projectDir}/environment.yml" }
            withName: 'BUILD_TABLE' { conda = "${projectDir}/environment.yml" }
            withName: 'KRONA'       { conda = "${projectDir}/environment.yml" }
        }
    }
}

// Default resource hints — override per-process in modules if needed.
//
// Resilience: retry only failures that more resources can fix. Exit
// codes 137..140 are the OOM / SIGKILL / SIGTERM range (e.g. an OOM
// killer or a scheduler walltime kill); those get up to `maxRetries`
// attempts with escalating memory. Deterministic failures (e.g. a
// validation error, exit 1) terminate immediately — retrying them only
// wastes time. Memory escalates with `task.attempt`: this is a genuine
// win under a scheduler (a bigger node on retry); on the local executor
// RAM is fixed, so it is mainly forward-compatibility for the `cluster`
// profile. `time` stays commented out until the cluster profile is
// fleshed out — there is no walltime enforcer under the local executor.
//
// The requests below are what each step *wants*. `resourceLimits` clamps
// every one of them — and every retry's escalated value — to
// params.max_cpus / params.max_memory, so they can be written for a
// well-provisioned machine without failing to schedule on a small one.
// A request above the ceiling is silently reduced, not refused: the
// startup notice in main.nf reports the effective ceiling so a run that
// used fewer threads than requested is explicable rather than mysterious.
process {
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory ]

    cpus   = 4
    memory = { 16.GB * task.attempt }
    // time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'BASECALL' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        // time   = { 12.h * task.attempt }
    }
    withName: 'SINTAX' {
        cpus   = 20
        memory = { 16.GB * task.attempt }
    }
    withName: 'BUILD_TABLE' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }
}
