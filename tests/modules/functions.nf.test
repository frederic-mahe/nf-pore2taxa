// Unit tests for the shared helpers in modules/local/functions.nf.
//
// These pin the boolean-parameter contract both consumers rely on: a
// value may arrive as a real Boolean (from a -config file) or as the
// string 'true'/'false' (from a CLI `--flag` override). See FN-01/FN-02
// in tests/SPECIFICATIONS.md.

nextflow_function {

    name "Shared functions"
    script "modules/local/functions.nf"

    // ------------------------------------------------------------- FN-01

    test("FN-01a coerce_bool: string 'true' -> Boolean true") {
        function "coerce_bool"
        when { function { """ input[0] = "true" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-01b coerce_bool: string 'false' -> Boolean false") {
        function "coerce_bool"
        when { function { """ input[0] = "false" """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-01c coerce_bool: Boolean true -> true") {
        function "coerce_bool"
        when { function { """ input[0] = true """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-01d coerce_bool: Boolean false -> false") {
        function "coerce_bool"
        when { function { """ input[0] = false """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-01e coerce_bool: any other value -> false") {
        function "coerce_bool"
        when { function { """ input[0] = "yes" """ } }
        then { assert function.success; assert function.result == false }
    }

    // ------------------------------------------------------------- FN-02

    test("FN-02a valid_bool: string 'true' is valid") {
        function "valid_bool"
        when { function { """ input[0] = "true" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02b valid_bool: string 'false' is valid") {
        function "valid_bool"
        when { function { """ input[0] = "false" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02c valid_bool: Boolean true is valid") {
        function "valid_bool"
        when { function { """ input[0] = true """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02d valid_bool: a non-boolean value is rejected") {
        function "valid_bool"
        when { function { """ input[0] = "yes" """ } }
        then { assert function.success; assert function.result == false }
    }

    // ------------------------------------------------------------- FN-03
    //
    // optimistic_name() must agree with name_optimistic_output() in
    // bin/build_occurrence_table.py for every shape of results_table,
    // because BUILD_TABLE declares its two outputs by name: a
    // disagreement is a "missing output file" at the end of a run.

    test("FN-03a optimistic_name inserts before a .tsv extension") {
        function "optimistic_name"
        when { function { """ input[0] = "sintax.tsv" """ } }
        then { assert function.success; assert function.result == "sintax_optimistic.tsv" }
    }

    test("FN-03b optimistic_name works for a non-.tsv extension") {
        function "optimistic_name"
        when { function { """ input[0] = "table.txt" """ } }
        then { assert function.success; assert function.result == "table_optimistic.txt" }
    }

    test("FN-03c optimistic_name appends when there is no extension") {
        function "optimistic_name"
        when { function { """ input[0] = "table" """ } }
        then { assert function.success; assert function.result == "table_optimistic" }
    }

    test("FN-03d optimistic_name splits on the LAST dot only") {
        function "optimistic_name"
        when { function { """ input[0] = "run.1.tsv" """ } }
        then { assert function.success; assert function.result == "run.1_optimistic.tsv" }
    }

    test("FN-03e optimistic_name: a leading dot is not an extension") {
        // Matches pathlib: Path('.hidden').suffix == '' .
        function "optimistic_name"
        when { function { """ input[0] = ".hidden" """ } }
        then { assert function.success; assert function.result == ".hidden_optimistic" }
    }

    // ------------------------------------------------------------- FN-04

    test("FN-04 fastq_extensions lists the four supported suffixes") {
        function "fastq_extensions"
        when { function { """ """ } }
        then {
            assert function.success
            assert function.result == ['fastq', 'fastq.gz', 'fastq.bz2', 'fastq.xz']
        }
    }
}
