// Unit tests for the shared helpers in modules/local/functions.nf.
//
// These pin the boolean-parameter contract both consumers rely on: a
// value may arrive as a real Boolean (from a -config file) or as the
// string 'true'/'false' (from a CLI `--flag` override). See FN-01/FN-02
// in tests/SPECIFICATIONS.md.

nextflow_function {

    name "Shared functions"
    script "modules/local/functions.nf"

    // ------------------------------------------------------------- FN-01

    test("FN-01a coerce_bool: string 'true' -> Boolean true") {
        function "coerce_bool"
        when { function { """ input[0] = "true" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-01b coerce_bool: string 'false' -> Boolean false") {
        function "coerce_bool"
        when { function { """ input[0] = "false" """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-01c coerce_bool: Boolean true -> true") {
        function "coerce_bool"
        when { function { """ input[0] = true """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-01d coerce_bool: Boolean false -> false") {
        function "coerce_bool"
        when { function { """ input[0] = false """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-01e coerce_bool: any other value -> false") {
        function "coerce_bool"
        when { function { """ input[0] = "yes" """ } }
        then { assert function.success; assert function.result == false }
    }

    // ------------------------------------------------------------- FN-02

    test("FN-02a valid_bool: string 'true' is valid") {
        function "valid_bool"
        when { function { """ input[0] = "true" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02b valid_bool: string 'false' is valid") {
        function "valid_bool"
        when { function { """ input[0] = "false" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02c valid_bool: Boolean true is valid") {
        function "valid_bool"
        when { function { """ input[0] = true """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-02d valid_bool: a non-boolean value is rejected") {
        function "valid_bool"
        when { function { """ input[0] = "yes" """ } }
        then { assert function.success; assert function.result == false }
    }

    // ------------------------------------------------------------- FN-03
    //
    // optimistic_name() must agree with name_optimistic_output() in
    // bin/build_occurrence_table.py for every shape of results_table,
    // because BUILD_TABLE declares its two outputs by name: a
    // disagreement is a "missing output file" at the end of a run.

    test("FN-03a optimistic_name inserts before a .tsv extension") {
        function "optimistic_name"
        when { function { """ input[0] = "sintax.tsv" """ } }
        then { assert function.success; assert function.result == "sintax_optimistic.tsv" }
    }

    test("FN-03b optimistic_name works for a non-.tsv extension") {
        function "optimistic_name"
        when { function { """ input[0] = "table.txt" """ } }
        then { assert function.success; assert function.result == "table_optimistic.txt" }
    }

    test("FN-03c optimistic_name appends when there is no extension") {
        function "optimistic_name"
        when { function { """ input[0] = "table" """ } }
        then { assert function.success; assert function.result == "table_optimistic" }
    }

    test("FN-03d optimistic_name splits on the LAST dot only") {
        function "optimistic_name"
        when { function { """ input[0] = "run.1.tsv" """ } }
        then { assert function.success; assert function.result == "run.1_optimistic.tsv" }
    }

    test("FN-03e optimistic_name: a leading dot is not an extension") {
        // Matches pathlib: Path('.hidden').suffix == '' .
        function "optimistic_name"
        when { function { """ input[0] = ".hidden" """ } }
        then { assert function.success; assert function.result == ".hidden_optimistic" }
    }

    // ------------------------------------------------------------- FN-04

    test("FN-04 fastq_extensions lists the four supported suffixes") {
        function "fastq_extensions"
        when { function { """ """ } }
        then {
            assert function.success
            assert function.result == ['fastq', 'fastq.gz', 'fastq.bz2', 'fastq.xz']
        }
    }

    // ------------------------------------------------------------- FN-05
    //
    // params.max_memory arrives as a real MemoryUnit (the auto-detected
    // default, or `128.GB` in a config) or as a String (a CLI
    // `--max_memory '32.GB'`). Both must pass; an unparseable value must
    // be caught at startup rather than at first task submission, where it
    // surfaces as a bare "Not a valid FileSize value".

    test("FN-05a valid_memory accepts the CLI string form") {
        function "valid_memory"
        when { function { """ input[0] = "32.GB" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-05b valid_memory accepts a spaced form") {
        // What a MemoryUnit stringifies to, e.g. '125.3 GB' from
        // auto-detection — it must survive a round trip.
        function "valid_memory"
        when { function { """ input[0] = "125.3 GB" """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-05c valid_memory accepts a real MemoryUnit") {
        function "valid_memory"
        when { function { """ input[0] = 8.GB """ } }
        then { assert function.success; assert function.result == true }
    }

    test("FN-05d valid_memory rejects a non-memory string") {
        function "valid_memory"
        when { function { """ input[0] = "banana" """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-05e valid_memory rejects a malformed size") {
        function "valid_memory"
        when { function { """ input[0] = "8.5.GB" """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-05f valid_memory rejects zero") {
        // '0' parses as a MemoryUnit but would clamp every request to
        // nothing, so it is not a usable ceiling.
        function "valid_memory"
        when { function { """ input[0] = "0" """ } }
        then { assert function.success; assert function.result == false }
    }

    test("FN-05g valid_memory rejects a negative size") {
        function "valid_memory"
        when { function { """ input[0] = "-1.GB" """ } }
        then { assert function.success; assert function.result == false }
    }

    // ------------------------------------------------------------- FN-06
    //
    // The thread count a process really gets: its configured request,
    // reduced by the ceiling. The randseed reproducibility warning keys
    // off this rather than the configured value, so that `--max_cpus 1`
    // (which genuinely does make a seeded run replayable) is not warned
    // about.

    test("FN-06a effective_threads: the ceiling wins when it is lower") {
        function "effective_threads"
        when { function { """ input[0] = 20 ; input[1] = 4 """ } }
        then { assert function.success; assert function.result == 4 }
    }

    test("FN-06b effective_threads: the request wins when it is lower") {
        function "effective_threads"
        when { function { """ input[0] = 2 ; input[1] = 24 """ } }
        then { assert function.success; assert function.result == 2 }
    }

    test("FN-06c effective_threads: a ceiling of 1 means single-threaded") {
        function "effective_threads"
        when { function { """ input[0] = 20 ; input[1] = 1 """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("FN-06d effective_threads: CLI string forms are handled") {
        // Both values can arrive as strings from resolved config / CLI.
        function "effective_threads"
        when { function { """ input[0] = "20" ; input[1] = "6" """ } }
        then { assert function.success; assert function.result == 6 }
    }

    test("FN-06e effective_threads: an unreadable request assumes the ceiling") {
        // e.g. someone set `cpus = { ... }` as a closure. For a warning,
        // assuming the whole ceiling is the conservative reading — better
        // to mention reproducibility when it may not hold than to stay
        // silent when it does not.
        function "effective_threads"
        when { function { """ input[0] = "not-a-number" ; input[1] = 8 """ } }
        then { assert function.success; assert function.result == 8 }
    }

    test("FN-06f effective_threads never returns less than 1") {
        function "effective_threads"
        when { function { """ input[0] = 0 ; input[1] = 0 """ } }
        then { assert function.success; assert function.result == 1 }
    }

    // ------------------------------------------------------------- FN-07
    //
    // The run's single output directory, and the deprecation shim that keeps
    // pre-v1.12.0 project configs producing exactly what they did before.

    test("FN-07a effective_outdir prefers outdir") {
        function "effective_outdir"
        when { function { """ input[0] = "/data/out" ; input[1] = "/elsewhere/t.tsv" """ } }
        then { assert function.success; assert function.result == "/data/out" }
    }

    test("FN-07b effective_outdir falls back to results_table's parent") {
        // What makes an existing config keep working unchanged.
        function "effective_outdir"
        when { function { """ input[0] = null ; input[1] = "/data/res/t.tsv" """ } }
        then { assert function.success; assert function.result == "/data/res" }
    }

    test("FN-07c effective_outdir: a bare filename means the launch dir") {
        function "effective_outdir"
        when { function { """ input[0] = null ; input[1] = "t.tsv" """ } }
        then { assert function.success; assert function.result == "." }
    }

    test("FN-07d effective_outdir defaults to results/") {
        // So `nextflow run main.nf` with neither is a valid invocation.
        function "effective_outdir"
        when { function { """ input[0] = null ; input[1] = null """ } }
        then { assert function.success; assert function.result == "results" }
    }

    // ------------------------------------------------------------- FN-08

    test("FN-08a effective_table_name prefers results_table's basename") {
        // So a migrating user's table keeps the name they chose.
        function "effective_table_name"
        when { function { """ input[0] = "sintax.tsv" ; input[1] = "/a/b/mine.tsv" """ } }
        then { assert function.success; assert function.result == "mine.tsv" }
    }

    test("FN-08b effective_table_name uses table_name otherwise") {
        function "effective_table_name"
        when { function { """ input[0] = "profile.tsv" ; input[1] = null """ } }
        then { assert function.success; assert function.result == "profile.tsv" }
    }

    // ------------------------------------------------------------- FN-09
    //
    // The "did you mean ...?" suggestion behind PRM-01. The threshold scales
    // with the name's length: one edit is a plausible slip in a short name,
    // three in a long one — but three edits from `krona` is a different word,
    // and guessing there would point the user somewhere wrong.

    test("FN-09a nearest_param finds a one-character slip") {
        function "nearest_param"
        when { function { """ input[0] = "subsampl" ; input[1] = ['subsample', 'randseed'] """ } }
        then { assert function.success; assert function.result == "subsample" }
    }

    test("FN-09b nearest_param handles a missing underscore") {
        function "nearest_param"
        when { function { """ input[0] = "primerf" ; input[1] = ['primer_f', 'primer_r'] """ } }
        then { assert function.success; assert function.result == "primer_f" }
    }

    test("FN-09c nearest_param declines to guess when nothing is close") {
        function "nearest_param"
        when { function { """ input[0] = "wibble" ; input[1] = ['subsample', 'krona'] """ } }
        then { assert function.success; assert function.result == null }
    }

    test("FN-09d nearest_param is case-insensitive") {
        function "nearest_param"
        when { function { """ input[0] = "Subsample" ; input[1] = ['subsample'] """ } }
        then { assert function.success; assert function.result == "subsample" }
    }

    test("FN-09e levenshtein counts single edits") {
        function "levenshtein"
        when { function { """ input[0] = "krona" ; input[1] = "kron" """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("FN-09f levenshtein is zero for identical strings") {
        function "levenshtein"
        when { function { """ input[0] = "outdir" ; input[1] = "outdir" """ } }
        then { assert function.success; assert function.result == 0 }
    }

    // ------------------------------------------------------------- FN-10

    test("FN-10 known_params lists the declared parameter surface") {
        // The content is pinned against the config by PRM-02; this only
        // checks the helper returns a usable list.
        function "known_params"
        when { function { """ """ } }
        then {
            assert function.success
            assert function.result.size() > 20
            assert function.result.contains('subsample')
            assert function.result.contains('outdir')
            // deprecated but still declared, so still accepted
            assert function.result.contains('results_table')
        }
    }
}
